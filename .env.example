# Copy to .env and fill in. .env is git-ignored — keep real values out of source control.

# --- Login (Oficina Virtual). Login is by EMAIL. Used only by login.py ---
EDERSA_USER=you@example.com
EDERSA_PASS=your-password

# --- Account context (REQUIRED for data reads) ---
# The querystring that identifies your account on the payment portal.
# Find it in your browser URL when viewing your bill detail, e.g.:
#   .../com.portalclientes.edersa.rwdhomemaster?0,123456,1,AIngreso,
# Format: <accountKey>,<cliente>,<suffix>,AIngreso,
EDERSA_HOME_QS=0,123456,1,AIngreso,

# --- Cookies (alternative to login.py; if set, edersa_client.py uses these directly) ---
# Option A: full Cookie header
# EDERSA_COOKIE=GX_SESSION_ID=...; GX_CLIENT_ID=...; JSESSIONID=...
# Option B: individual cookies
# EDERSA_GX_SESSION_ID=
# EDERSA_GX_CLIENT_ID=
# EDERSA_JSESSIONID=

# Optional: run the login browser visibly for debugging (default headless)
# EDERSA_HEADLESS=0
